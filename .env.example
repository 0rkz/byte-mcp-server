# Private key for write operations (subscribe, publish, register, buy).
# Optional -- without it, only read-only tools are available.
# PRIVATE_KEY=0x...

# Arbitrum Sepolia RPC endpoint (default shown below).
# RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# PayPerByte indexer API URL. Default is the hosted indexer:
#   https://feeds.payperbyte.io
# Uncomment only to point at a local dev indexer.
# INDEXER_URL=http://localhost:8080

# Optional server-side spend cap for byte_buy_data, in decimal USDC.
# When set, any 402 quote above the cap is refused before signing.
# Unset = uncapped; a dedicated thin wallet remains the hard backstop.
# MAX_PAYMENT_USDC=0.25
